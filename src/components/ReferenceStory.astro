---
import StoryImage from "./StoryImage.astro";
const { lang = "de" } = Astro.props;
const en = lang === "en";
const t = (de: string, english: string) => (en ? english : de);
const e = "/bonanza/experiences/",
  c = "/bonanza/concepts/";
const images = [
  "horse",
  "giraffes",
  "elephant",
  "lake",
  "kudu",
  "safari-drive",
  "mountain-lake",
  "protea",
  "bird",
  "bush-trail",
  "rhino",
  "cheetahs",
  "wildflowers",
];
---

<section class="wild-worlds" id="wildnis" data-nav-theme="light">
  <header class="worlds-intro">
    <h2 class="worlds-heading">
      <span>{t("Wildnis.", "Wilderness.")}</span>
      <em>{t("Ganz nah.", "Up close.")}</em>
    </h2>
  </header>
  <div class="worlds-stage">
    <div class="worlds-webgl" aria-hidden="true">
      <div class="worlds-fallback">
        {["kudu", "giraffes", "elephant"].map((name) => (
          <img
            src={`${e}${name}.webp`}
            alt=""
            width="1440"
            height="960"
            loading="lazy"
          />
        ))}
      </div>
    </div>
    <div class="worlds-captions">
      <div class="worlds-caption">
        <h3>
          {t("Natur erleben.", "Explore.")}{" "}
          <em>{t("Ganz privat.", "In private.")}</em>
        </h3>
        <p>
          {t(
            "Persönlich begleitete Ausfahrten mit erfahrenen Rangern sind für Eigentümer und ihre Gäste vorgesehen. Anhalten, beobachten und die Wildnis im eigenen Rhythmus entdecken.",
            "Private drives with experienced rangers are planned exclusively for owners and their guests. Time to stop, observe wildlife and explore at your own pace.",
          )}
        </p>
      </div>
      <div class="worlds-caption">
        <h3>
          {t("Beobachten.", "Watch.")}{" "}
          <em>{t("Zeit vergessen.", "Forget the time.")}</em>
        </h3>
        <p>
          {t(
            "Eine Herde am Horizont. Ein Rascheln im Busch. Begegnungen, für die man keinen Termin braucht.",
            "A herd on the horizon. A rustle in the bush. Encounters you cannot put in a diary.",
          )}
        </p>
      </div>
      <div class="worlds-caption">
        <h3>
          {t("Wildnis braucht", "Wildlife needs")}{" "}
          <em>{t("Freiraum.", "room to roam.")}</em>
        </h3>
        <p>
          {t(
            "Das bestehende Wildtierschutzgebiet rund um die Bonanza Ranch bietet Südafrikas Tierwelt weite Lebensräume. Diese Landschaft und ihre Artenvielfalt zu bewahren und seltene Arten zu schützen, ist Teil der Bonanza-Vision.",
            "The existing wildlife reserve surrounding Bonanza Ranch provides open habitats for South Africa’s wildlife. Preserving this landscape, its biodiversity and rare species is part of the Bonanza vision.",
          )}
        </p>
      </div>
    </div>
  </div>
</section>
<section
  class="life-film"
  id="freizeit"
  data-nav-theme="light"
  aria-label={t(
    "Die geplanten Erlebnisse auf Bonanza",
    "Experiences envisaged on Bonanza",
  )}
>
  <div class="life-stage">
    <div class="life-track">
      <article class="life-chapter life-intro" data-life-chapter>
        <div class="life-card">
          <h2 class="life-card-title">{t("ERLEBNISSE", "EXPERIENCES")}</h2>
          <p class="life-card-summary">
            {t(
              "Morgens mit den Pferden aufbrechen. Durch die weite Landschaft ziehen. Abends dem Knistern des Feuers lauschen. So stellen wir uns die Tage auf Bonanza vor.",
              "Set out with the horses in the morning. Ride into the open landscape. Listen to the fire crackle as evening falls. This is how we imagine the days at Bonanza.",
            )}
          </p>
          <div class="life-card-picture">
            <StoryImage
              src={`${e}horse.webp`}
              alt={t("Pferd im hohen Gras", "Horse in tall grass")}
              position="50% 15%"
            />
            <h3>
              <em>{t("Im", "In the")}</em>
              <span>{t("SATTEL", "SADDLE")}</span>
            </h3>
            <p>
              {t(
                "Mit einem Pferdeflüsterer in den Tag starten. Vertrauen fassen, aufsitzen, der endlosen Weite entgegenreiten. Country Horse Riding – persönlich begleitete Ausritte durch die offene Landschaft – und eine eigene Reitanlage gehören zur Vision für Bonanza.",
                "Begin the day with a horse whisperer. Build trust, settle into the saddle and ride towards the open horizon. Country horse riding, with personally guided rides through open landscapes and private stables, is part of the Bonanza vision.",
              )}
            </p>
          </div>
        </div>
      </article>
      <article
        class="life-chapter life-full-photo"
        aria-label={t("Private Ausfahrten mit Rangern", "Private ranger-led drives")}
      >
        <StoryImage
          src={`${e}safari-drive.webp`}
          caption={t("Im 4×4-Jeep mit Ihrem Ranger den Spuren der Wildnis folgen. Anhalten, staunen, die Stille wirken lassen · private Ausfahrten geplant", "Follow the tracks of wildlife in a 4×4 jeep with your ranger. Stop, take it in and listen to the stillness · private drives planned")}
          alt={t(
            "Safari-Ausfahrt in Südafrika",
            "Safari drive in South Africa",
          )}
        />
      </article>
      <article class="life-chapter life-wildlife" id="tierwelt" data-life-chapter>
        <StoryImage
          src={`${e}giraffes.webp`}
          alt={t("Giraffen zwischen den Büschen der Klein Karoo", "Giraffes among the bushes of the Klein Karoo")}
          position="58% 50%"
        />
        <div class="wildlife-copy">
          <h3>
            <em>{t("Südafrikas", "South Africa’s")}</em>
            <span>{t("TIERWELT.", "WILDLIFE.")}</span>
          </h3>
          <p>
            {t(
              "Majestätische Giraffen zwischen den Bäumen. Zebraherden in der weiten Ebene. Springböcke, die mit einem Satz die Stille durchbrechen. Bonanza ist Heimat einer reichen Tierwelt.",
              "Majestic giraffes among the trees. Herds of zebras on the open plains. Springbok breaking the stillness with a single leap. Bonanza is home to an abundance of wildlife.",
            )}
          </p>
          <p>
            {t(
              "Auch Kudus, Eland- und Oryx-Antilopen ziehen durch diese Landschaft. Wer sich Zeit nimmt, entdeckt immer mehr: ein leises Rascheln, ein Blick aus dem Busch, eine Herde am Horizont.",
              "Kudu, eland and oryx also roam this landscape. Take your time and more comes into view: a soft rustle, a watchful gaze from the bush, a herd on the horizon.",
            )}
          </p>
        </div>
      </article>
      <article class="life-chapter life-iconic" data-life-chapter>
        <div class="iconic-column">
          <h3>
            <em>{t("Ans", "By the")}</em>
            <span>{t("WASSER", "WATER")}</span>
          </h3>
          <p>
            {t(
              "Glitzerndes Wasser, schattige Ufer, ein weiter Himmel. Unsere Vision: morgens auf Forellenbarsch (Largemouth Bass) angeln, im Kajak stille Buchten entdecken, mit dem Jetski die Freiheit spüren. Raum für Ihre Leidenschaft am Wasser.",
              "Shimmering water, shady shores, an open sky. Our vision: mornings fishing for largemouth bass, quiet coves explored by kayak, the freedom of a jet ski. Room for your passion on the water.",
            )}
          </p>
          <StoryImage
            src={`${e}lake.webp`}
            alt={t(
              "See in weiter Berglandschaft",
              "Lake in open mountain scenery",
            )}
          />
        </div>
      </article>
      <article class="life-chapter life-full-photo">
        <StoryImage
          src={`${e}bush-trail.webp`}
          caption={t("Durch wilden Busch wandern. Kleine Höhlen mit Felsmalereien der San entdecken. Auf ausgedehnten Bike-Touren mit Mountainbike oder Gravelbike den Wind im Gesicht spüren · geplante Erlebnisse", "Walk through untamed bush. Discover small caves with San rock paintings. Feel the wind on long mountain or gravel bike tours · planned experiences")}
          alt={t(
            "Wege durch die südafrikanische Landschaft",
            "Trails through South African countryside",
          )}
        />
      </article>
      <article class="life-chapter life-finesse" data-life-chapter>
        <h3>
          <em>{t("Lust auf", "Time for")}</em>
          <span>{t("EIN MATCH?", "A MATCH?")}</span>
        </h3>
        <div class="finesse-pictures">
          <StoryImage
            src={`${c}racket-concept.webp`}
            caption={t("Padel bis in den Abend · beleuchtete Courts geplant", "Padel into the evening · floodlit courts planned")}
            alt={t("Padel und Tennis, Konzeptbild", "Padel and tennis concept")}
            concept
            lang={lang}
          />
          <StoryImage
            src={`${c}golf-concept.webp`}
            caption={t("Weite Fairways, großer Himmel · Golf in der Umgebung", "Open fairways, wide skies · golf in the surrounding area")}
            alt={t(
              "Golfausflug, Symbolbild",
              "Golf outing, illustrative image",
            )}
            concept
            lang={lang}
          />
          <StoryImage
            src={`${c}tennis-court-concept.webp`}
            alt={t("Tennisplatz in der Klein Karoo, Konzeptbild", "Tennis court in the Klein Karoo, concept")}
            caption={t("Ein Match unter freiem Himmel · Tennisplätze geplant", "A match beneath open skies · tennis courts planned")}
            concept
            lang={lang}
          />
        </div>
        <p>
          {t(
            "Ein Doppel am Haupthaus, danach auf die Terrasse. Noch warm von der Sonne, den Abend vor sich. Padel, Tennis und Tischtennis sind geplant, ebenso Bogenschießen, Tontaubenschießen und sportliches Schießen auf der Shooting Range. Für eine Runde Golf geht es in die Umgebung.",
            "Doubles by the main lodge, then a seat on the terrace. Still warm from the sun, with the evening ahead. Plans include padel, tennis, table tennis, archery, clay pigeon shooting and target shooting at the range, with golf outings in the surrounding area.",
          )}
        </p>
      </article>
      <article class="life-chapter life-amenities" data-life-chapter>
        <p>
          {t(
            "Warmes Wasser auf der Haut. Der Duft von Holzfeuer in der Abendluft. Ein guter Wein, ein langer Tisch, vertraute Gesichter. Mit Pool, Spa, Sauna und einem Clubhaus für gesellige Braai-Abende soll auch das Genießen seinen festen Platz bekommen.",
            "Warm water on your skin. The scent of a wood fire on the evening air. Fine wine, a long table, familiar faces. Plans for a pool, spa, sauna and clubhouse with convivial braai evenings make room for these pleasures, too.",
          )}
        </p>
        <div class="amenities-pictures">
          <StoryImage
            src={`${c}wellbeing-concept.webp`}
            caption={t("Pool, Spa & Sauna · geplant", "Pool, spa & sauna · planned")}
            alt={t(
              "Geplanter Wellnessbereich, Konzeptbild",
              "Planned wellness area, concept",
            )}
            concept
            lang={lang}
          />
          <StoryImage
            src={`${c}clubhouse-concept.webp`}
            caption={t("Clubhaus, Boma & Sternen-Deck · geplant", "Clubhouse, boma & stargazing deck · planned")}
            alt={t(
              "Clubhaus im Abendlicht, Konzeptbild",
              "Clubhouse at dusk, concept",
            )}
            concept
            lang={lang}
          />
          <h3>
            <em>{t("Lange", "Long")}</em>
            <span>{t("ABENDE", "EVENINGS")}</span>
          </h3>
        </div>
      </article>
      <article class="life-chapter life-service" data-life-chapter>
        <div class="service-copy">
          <p>
            {t(
            "Der Tisch ist gedeckt. Ihr Lieblingswein steht bereit. Sie haben Zeit für Ihre Gäste. Persönlicher Butler-Service, ein Privatkoch und organisierte Transfers sind vorgesehen – bis hin zur Anreise am geplanten Helikopter-Landeplatz.",
            "The table is set. Your favourite wine is ready. You have time for your guests. Plans include a personal butler, a private chef and arranged transfers, with a helicopter landing area envisaged for your arrival.",
            )}
          </p>
        </div>
        <StoryImage
          src={`${c}helipad-concept.webp`}
          caption={t("Anreise per Helikopter · Landeplatz geplant", "Arrive by helicopter · landing area planned")}
          alt={t(
            "Helikopter-Anreise, Konzeptbild",
            "Helicopter arrival concept",
          )}
          class="service-left"
          concept
          lang={lang}
        />
        <div class="service-center">
          <h3>
            <em>{t("Butler &", "Butler &")}</em>
            <span>{t("PRIVATKOCH", "PRIVATE CHEF")}</span>
          </h3>
          <StoryImage
            src={`${c}butler-dinner-concept.webp`}
            alt={t(
              "Persönlicher Dinner-Service auf der Veranda, Konzeptbild",
              "Personal dinner service on the veranda, concept",
            )}
            concept
            lang={lang}
          />
        </div>
        <StoryImage
          src={`${c}residence-concept.webp`}
          caption={t("Ihr Rückzugsort · die Ranch als Zuhause", "Your retreat · a ranch to call home")}
          alt={t(
            "Privater Rückzugsort, Konzeptbild",
            "Private retreat concept",
          )}
          class="service-right"
          concept
          lang={lang}
        />
      </article>
      <article
        class="life-chapter life-privacy"
        id="sicherheit"
        data-life-chapter
      >
        <StoryImage
          src={`${c}security-gate-concept.webp`}
          alt={t(
            "Kontrollierte Zufahrt, Konzeptbild",
            "Controlled entrance concept",
          )}
          concept
          lang={lang}
        />
        <h3>
          <em>{t("Privat.", "Private.")}</em>
          <span>{t("TAG UND NACHT.", "DAY AND NIGHT.")}</span>
        </h3>
      </article>
      <article class="life-chapter life-security-detail" data-life-chapter>
        <div class="security-copy">
          <p>{t("Die Landschaft bleibt offen. Der Zugang ist kontrolliert. So ist das Sicherheitskonzept für Bonanza gedacht.", "Open landscapes. Controlled access. That is the approach planned for security at Bonanza.")}</p>
          <dl class="security-facts">
            <div><dt>24/7</dt><dd>{t("Besetzte Kontrollzentrale und Sicherheitsteams vor Ort geplant.", "A staffed control centre and on-site security teams are planned.")}</dd></div>
            <div><dt>{t("Zugang", "Access")}</dt><dd>{t("Kontrollierte Zufahrten und biometrischer Zutritt für Eigentümer, Gäste und Personal vorgesehen.", "Controlled entrances and biometric access for owners, guests and staff are envisaged.")}</dd></div>
            <div><dt>{t("Technik", "Technology")}</dt><dd>{t("Wärmebildkameras, Zonensensorik und Drohnenpatrouillen im Konzept.", "Thermal cameras, zonal sensors and drone patrols form part of the concept.")}</dd></div>
          </dl>
          <p class="security-infrastructure">{t("Auch Solarstrom, Speicher, eigene Wasserversorgung und schnelles Internet sind Teil der Planung.", "Solar power, storage, an independent water supply and high-speed internet are also part of the plans.")}</p>
        </div>
        <div class="life-vertical-gallery">
          <StoryImage
            src={`${c}security-camera-concept.webp`}
            caption={t("Diskrete Überwachung der Außengrenzen", "Discreet monitoring of the perimeter")}
            alt={t(
              "Kameratechnik, Konzeptbild",
              "Monitoring technology concept",
            )}
            concept
            lang={lang}
          />
          <StoryImage
            src={`${c}security-gate-concept.webp`}
            caption={t("Kontrollierte Zufahrt zum Estate", "Controlled access to the estate")}
            alt={t("Zugangskontrolle, Konzeptbild", "Access control concept")}
            concept
            lang={lang}
          />
        </div>
      </article>
      <article class="life-chapter life-finale">
        <StoryImage
          src={`${c}karoo-night-sky.webp`}
          alt={t(
            "Nachthimmel über der Klein Karoo, Konzeptbild",
            "Night sky over the Klein Karoo, concept",
          )}
          concept
          lang={lang}
        />
        <h3>
          <span>{t("Ein Himmel.", "One sky.")}</span>
          <em>{t("Unendlich weit.", "Beyond the horizon.")}</em>
        </h3>
        <p>
          {t(
            "Fern vom Licht der Städte. Über Ihnen die Milchstraße, vor Ihnen die Weite der Karoo.",
            "Far from the city lights. The Milky Way above you, the open Karoo stretching into the night.",
          )}
        </p>
      </article>
    </div>
  </div>
</section>
<section
  class="bonanza-ring"
  id="augenblicke"
  data-nav-theme="light"
  aria-label={t("Augenblicke auf Bonanza", "Moments at Bonanza")}
>
  <div class="ring-stage">
    <div class="ring-webgl" aria-hidden="true">
      <div class="ring-fallback">
        {images.map((name) => (
          <img
            src={`${e}${name}.webp`}
            alt=""
            width="1440"
            height="960"
            loading="lazy"
          />
        ))}
      </div>
    </div>
    <div class="ring-title">
      <h2>
        <em>{t("Hier bleiben.", "Stay a while.")}</em>
      </h2>
      <p>
        {t(
          "Ein privater Rückzugsort. In Südafrikas weiter Landschaft.",
          "A private retreat. In South Africa’s open country.",
        )}
      </p>
    </div>
  </div>
  <div class="ring-story">
    <p class="ring-text-first">
      {t(
        "Vielleicht ist es die Weite. Vielleicht die Nähe zur Natur. Vielleicht der Gedanke, wiederzukommen — und zu bleiben.",
        "Perhaps it is the open space. Perhaps the closeness to nature. Perhaps the thought of returning — and staying.",
      )}
    </p>
    <div></div>
    <p class="ring-text-last">
      {t(
        "BONANZA RANCH. DIE VISION VON EINEM LEBEN IN SÜDAFRIKA.",
        "BONANZA RANCH. A VISION FOR LIFE IN SOUTH AFRICA.",
      )}
    </p>
  </div>
</section>
