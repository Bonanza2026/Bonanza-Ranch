---
import StoryImage from "./StoryImage.astro";
import StoryChapter from "./StoryChapter.astro";
const { lang = "de" } = Astro.props;
const en = lang === "en";
const t = (de: string, english: string) => (en ? english : de);
const e = "/bonanza/experiences/",
  c = "/bonanza/concepts/";
const images = [
  "horse",
  "giraffes",
  "elephant",
  "lake",
  "kudu",
  "safari-drive",
  "mountain-lake",
  "protea",
  "bird",
  "bush-trail",
  "rhino",
  "cheetahs",
  "wildflowers",
];
---

<section class="wild-worlds" id="wildnis" data-nav-theme="light">
  <header class="worlds-intro">
    <h2 class="worlds-heading">
      <span>{t("Wildnis.", "Wilderness.")}</span>
      <em>{t("Ganz nah.", "Up close.")}</em>
    </h2>
  </header>
  <div class="worlds-stage">
    <div class="worlds-webgl" aria-hidden="true">
      <div class="worlds-fallback">
        {["kudu", "giraffes", "elephant"].map((name) => (
          <img
            src={`${e}${name}.webp`}
            alt=""
            width="1440"
            height="960"
            loading="lazy"
          />
        ))}
      </div>
    </div>
    <div class="worlds-captions">
      <div class="worlds-caption">
        <h3>
          {t("Natur erleben.", "Explore.")}{" "}
          <em>{t("Ganz privat.", "In private.")}</em>
        </h3>
        <p>
          {t(
            "Mit erfahrenen Rangern aufbrechen. Ganz privat, als Eigentümer oder Gast. Anhalten, beobachten und die Wildnis im eigenen Rhythmus entdecken.",
            "Set out with experienced rangers. In private, as an owner or guest. Time to stop, observe wildlife and explore at your own pace.",
          )}
        </p>
      </div>
      <div class="worlds-caption">
        <h3>
          {t("Beobachten.", "Watch.")}{" "}
          <em>{t("Zeit vergessen.", "Forget the time.")}</em>
        </h3>
        <p>
          {t(
            "Eine Herde am Horizont. Ein Rascheln im Busch. Begegnungen, für die man keinen Termin braucht.",
            "A herd on the horizon. A rustle in the bush. Encounters you cannot put in a diary.",
          )}
        </p>
      </div>
      <div class="worlds-caption">
        <h3>
          {t("Wildnis braucht", "Wildlife needs")}{" "}
          <em>{t("Freiraum.", "room to roam.")}</em>
        </h3>
        <p>
          {t(
            "Das bestehende Wildtierschutzgebiet rund um die Bonanza Ranch bietet Südafrikas Tierwelt weite Lebensräume. Diese Landschaft und ihre Artenvielfalt zu bewahren und seltene Arten zu schützen, ist Teil der Bonanza-Vision.",
            "The existing wildlife reserve surrounding Bonanza Ranch provides open habitats for South Africa’s wildlife. Preserving this landscape, its biodiversity and rare species is part of the Bonanza vision.",
          )}
        </p>
      </div>
    </div>
  </div>
</section>
<section
  class="life-film"
  id="freizeit"
  data-nav-theme="light"
  aria-label={t(
    "Erlebnisse auf Bonanza",
    "Experiences on Bonanza",
  )}
>
  <div class="life-stage">
    <div class="life-track">
      <article class="life-chapter life-intro" data-life-chapter>
        <div class="life-card">
          <h2 class="life-card-title">{t("ERLEBNISSE", "EXPERIENCES")}</h2>
          <p class="life-card-summary">
            {t(
              "Morgens mit den Pferden aufbrechen. Durch die weite Landschaft ziehen. Abends dem Knistern des Feuers lauschen. So stellen wir uns die Tage auf Bonanza vor.",
              "Set out with the horses in the morning. Ride into the open landscape. Listen to the fire crackle as evening falls. This is how we imagine the days at Bonanza.",
            )}
          </p>
          <div class="life-card-picture">
            <StoryImage
              src={`${e}horse.webp`}
              alt={t("Pferd im hohen Gras", "Horse in tall grass")}
              position="50% 15%"
            />
            <h3>
              <em>{t("Im", "In the")}</em>
              <span>{t("SATTEL", "SADDLE")}</span>
            </h3>
            <p>
              {t(
                "Mit einem Pferdeflüsterer in den Tag starten. Vertrauen fassen, aufsitzen, der endlosen Weite entgegenreiten. Country Horse Riding – persönlich begleitete Ausritte durch die offene Landschaft – und eine eigene Reitanlage gehören zur Vision für Bonanza.",
                "Begin the day with a horse whisperer. Build trust, settle into the saddle and ride towards the open horizon. Country horse riding, with personally guided rides through open landscapes and private stables, is part of the Bonanza vision.",
              )}
            </p>
          </div>
        </div>
      </article>
      <article
        class="life-chapter life-full-photo"
        aria-label={t("Private Ausfahrten mit Rangern", "Private ranger-led drives")}
      >
        <StoryImage
          src={`${e}safari-drive.webp`}
          caption={t("Im 4×4-Jeep mit Ihrem Ranger den Spuren der Wildnis folgen. Anhalten, staunen, die Stille wirken lassen. Ein Erlebnis!", "Follow the tracks of wildlife in a 4×4 jeep with your ranger. Stop, take it in and listen to the stillness. What an experience!")}
          alt={t(
            "Safari-Ausfahrt in Südafrika",
            "Safari drive in South Africa",
          )}
        />
      </article>
      <StoryChapter lead={t("Südafrikas", "South Africa’s")} title={t("TIERWELT.", "WILDLIFE.")} id="tierwelt" imageFirst>
        <Fragment slot="copy">
          <p>{t("Majestätische Giraffen zwischen den Bäumen. Zebraherden in der weiten Ebene. Springböcke, die mit einem Satz die Stille durchbrechen. Bonanza ist Heimat einer reichen Tierwelt.", "Majestic giraffes among the trees. Herds of zebras on the open plains. Springbok breaking the stillness with a single leap. Bonanza is home to an abundance of wildlife.")}</p>
          <p>{t("Auch Kudus, Eland- und Oryx-Antilopen ziehen durch diese Landschaft. Wer sich Zeit nimmt, entdeckt immer mehr: ein leises Rascheln, ein Blick aus dem Busch, eine Herde am Horizont.", "Kudu, eland and oryx also roam this landscape. Take your time and more comes into view: a soft rustle, a watchful gaze from the bush, a herd on the horizon.")}</p>
        </Fragment>
        <StoryImage src={`${e}giraffes.webp`} alt={t("Giraffen zwischen den Büschen der Klein Karoo", "Giraffes among the bushes of the Klein Karoo")} position="58% 50%" />
      </StoryChapter>
      <StoryChapter lead={t("Ans", "By the")} title={t("WASSER", "WATER")} id="wasser">
        <p slot="copy">{t("Glitzerndes Wasser, schattige Ufer, ein weiter Himmel. Unsere Vision: morgens auf Forellenbarsch (Largemouth Bass) angeln, im Kajak stille Buchten entdecken, mit dem Jetski die Freiheit spüren. Hier soll Wassersport so vielseitig werden wie Ihre Wünsche.", "Shimmering water, shady shores, an open sky. Our vision: mornings fishing for largemouth bass, quiet coves explored by kayak, the freedom of a jet ski. The water sports envisaged here leave room for every mood.")}</p>
        <StoryImage src={`${e}lake.webp`} alt={t("See in weiter Berglandschaft", "Lake in open mountain scenery")} />
      </StoryChapter>
      <StoryChapter lead={t("Draußen", "Out in the")} title={t("UNTERWEGS", "OPEN")} id="entdecken" imageFirst>
        <p slot="copy">{t("Durch wilden Busch wandern. Kleine Höhlen mit Felsmalereien der San entdecken. Auf ausgedehnten Bike-Touren mit Mountainbike oder Gravelbike den Wind im Gesicht spüren.", "Walk through untamed bush. Discover small caves with San rock paintings. Feel the wind on long mountain or gravel bike tours.")}</p>
        <StoryImage src={`${e}bush-trail.webp`} alt={t("Wege durch die südafrikanische Landschaft", "Trails through South African countryside")} />
      </StoryChapter>
      <StoryChapter lead={t("Lust auf", "Time for")} title={t("EIN MATCH?", "A MATCH?")} id="sport">
        <Fragment slot="copy">
          <p>{t("Ein beherzter Aufschlag. Ein langer Ballwechsel. Danach auf die Terrasse, noch warm von der Sonne, den Abend vor sich. Padel, Tennis und Tischtennis für die Freude am Spiel.", "A confident serve. A long rally. Then a seat on the terrace, still warm from the sun, with the evening ahead. Padel, tennis and table tennis for the pleasure of the game.")}</p>
          <p>{t("Konzentration beim Bogenschießen. Ein gutes Auge beim Tontaubenschießen und auf der Shooting Range. Oder hinaus auf die weiten Fairways der Umgebung.", "Focus at the archery range. A keen eye for clay pigeons and target shooting. Or head out to the open fairways of the surrounding countryside.")}</p>
        </Fragment>
        <StoryImage src={`${c}racket-concept.webp`} caption={t("Padel bis in den Abend", "Padel into the evening")} alt={t("Padel und Tennis, Konzeptbild", "Padel and tennis concept")} concept lang={lang} />
        <StoryImage src={`${c}golf-concept.webp`} caption={t("Weite Fairways, großer Himmel", "Open fairways, wide skies")} alt={t("Golfausflug, Symbolbild", "Golf outing, illustrative image")} concept lang={lang} />
        <StoryImage src={`${c}tennis-court-concept.webp`} caption={t("Ein Match unter freiem Himmel", "A match beneath open skies")} alt={t("Tennisplatz, Konzeptbild", "Tennis court concept")} concept lang={lang} />
      </StoryChapter>
      <StoryChapter lead={t("Lange", "Long")} title={t("ABENDE", "EVENINGS")} id="geniessen">
        <p slot="copy">{t("Warmes Wasser auf der Haut. Wohlige Ruhe in Spa und Sauna. Später zieht der Duft von Holzfeuer durch die Abendluft. Ein vollmundiger Wein, ein liebevoll gedeckter Tisch, vertraute Gesichter. Am Boma-Feuer verweilen, bis über dem Sternen-Deck die Nacht aufzieht.", "Warm water on your skin. Deep relaxation in the spa and sauna. Later, the scent of a wood fire drifts through the evening air. A full-bodied wine, a beautifully laid table, familiar faces. Linger by the boma fire as night settles over the stargazing deck.")}</p>
        <StoryImage src={`${c}wellbeing-concept.webp`} caption={t("Pool, Spa & Sauna", "Pool, spa & sauna")} alt={t("Wellnessbereich, Konzeptbild", "Wellness area concept")} concept lang={lang} />
        <StoryImage src={`${c}clubhouse-concept.webp`} caption={t("Clubhaus, Boma & Sternen-Deck", "Clubhouse, boma & stargazing deck")} alt={t("Clubhaus im Abendlicht, Konzeptbild", "Clubhouse at dusk, concept")} concept lang={lang} />
      </StoryChapter>
      <StoryChapter lead={t("Butler &", "Butler &")} title={t("PRIVATKOCH", "PRIVATE CHEF")} id="service">
        <p slot="copy">{t("Vom Flughafen direkt in die Ruhe der Ranch. Persönlich organisierte Airport-Transfers lassen Sie entspannt ankommen. Ihr Butler kümmert sich um die kleinen Wünsche, Ihr Privatkoch um einen genussvollen Abend. Dazu ein charaktervoller Wein vom eigenen Weingut. Ihnen bleibt das Schönste: Zeit für Ihre Gäste.", "From the airport straight to the quiet of the ranch. Personally arranged airport transfers make arrival effortless. Your butler attends to the little wishes, your private chef prepares an evening to savour. Add a characterful wine from our own vineyard. You have the best part: time for your guests.")}</p>
        <StoryImage src={`${c}helipad-concept.webp`} caption={t("Anreise per Helikopter", "Arrive by helicopter")} alt={t("Helikopter-Anreise, Konzeptbild", "Helicopter arrival concept")} concept lang={lang} />
        <StoryImage src={`${c}butler-dinner-concept.webp`} alt={t("Persönlicher Dinner-Service auf der Veranda, Konzeptbild", "Personal dinner service on the veranda, concept")} concept lang={lang} />
        <StoryImage src={`${c}residence-concept.webp`} caption={t("Die Ranch als Zuhause", "A ranch to call home")} alt={t("Privater Rückzugsort, Konzeptbild", "Private retreat concept")} concept lang={lang} />
      </StoryChapter>
      <StoryChapter lead={t("Privat.", "Private.")} title={t("TAG UND NACHT.", "DAY AND NIGHT.")} id="sicherheit">
        <Fragment slot="copy">
          <p>{t("Weite Landschaft. Geschützte Privatsphäre. Persönliche Aufmerksamkeit und diskrete Technik.", "Open landscapes. Protected privacy. Personal attention and discreet technology.")}</p>
          <dl class="security-facts">
            <div><dt>24/7</dt><dd>{t("Kontrollzentrale und Sicherheitsteams vor Ort.", "Control centre and on-site security teams.")}</dd></div>
            <div><dt>{t("Zugang", "Access")}</dt><dd>{t("Kontrollierte Zufahrten und biometrischer Zutritt.", "Controlled entrances and biometric access.")}</dd></div>
            <div><dt>{t("Technik", "Technology")}</dt><dd>{t("Wärmebildkameras, Zonensensorik und Drohnenpatrouillen.", "Thermal cameras, zonal sensors and drone patrols.")}</dd></div>
          </dl>
          <p>{t("Eigener Solarstrom. Leistungsstarke Speicher. Wasser aus eigener Versorgung. Dazu schnelles Internet – weit weg vom Alltag, verbunden mit der Welt.", "Your own solar power. High-capacity battery storage. An independent water supply. And fast internet – far from the everyday, connected to the world.")}</p>
        </Fragment>
        <div class="life-vertical-gallery">
          <StoryImage src={`${c}security-camera-concept.webp`} caption={t("Diskrete Überwachung der Außengrenzen", "Discreet monitoring of the perimeter")} alt={t("Kameratechnik, Konzeptbild", "Monitoring technology concept")} concept lang={lang} />
          <StoryImage src={`${c}security-gate-concept.webp`} caption={t("Kontrollierte Zufahrt zum Estate", "Controlled access to the estate")} alt={t("Zugangskontrolle, Konzeptbild", "Access control concept")} concept lang={lang} />
        </div>
      </StoryChapter>
      <article class="life-chapter life-finale">
        <StoryImage
          src={`${c}karoo-night-sky.webp`}
          alt={t(
            "Nachthimmel über der Klein Karoo, Konzeptbild",
            "Night sky over the Klein Karoo, concept",
          )}
          concept
          lang={lang}
        />
        <h3>
          <span>{t("Ein Himmel.", "One sky.")}</span>
          <em>{t("Unendlich weit.", "Beyond the horizon.")}</em>
        </h3>
        <p>
          {t(
            "Fern vom Licht der Städte. Über Ihnen die Milchstraße, vor Ihnen die Weite der Karoo.",
            "Far from the city lights. The Milky Way above you, the open Karoo stretching into the night.",
          )}
        </p>
      </article>
    </div>
  </div>
</section>
<section
  class="bonanza-ring"
  id="augenblicke"
  data-nav-theme="light"
  aria-label={t("Augenblicke auf Bonanza", "Moments at Bonanza")}
>
  <div class="ring-stage">
    <div class="ring-webgl" aria-hidden="true">
      <div class="ring-fallback">
        {images.map((name) => (
          <img
            src={`${e}${name}.webp`}
            alt=""
            width="1440"
            height="960"
            loading="lazy"
          />
        ))}
      </div>
    </div>
    <div class="ring-title">
      <h2>
        <em>{t("Hier bleiben.", "Stay a while.")}</em>
      </h2>
      <p>
        {t(
          "Ein privater Rückzugsort. In Südafrikas weiter Landschaft.",
          "A private retreat. In South Africa’s open country.",
        )}
      </p>
    </div>
  </div>
  <div class="ring-story">
    <p class="ring-text-first">
      {t(
        "Vielleicht ist es die Weite. Vielleicht die Nähe zur Natur. Vielleicht der Gedanke, wiederzukommen und für immer zu bleiben.",
        "Perhaps it is the open space. Perhaps the closeness to nature. Perhaps the thought of returning and staying for good.",
      )}
    </p>
    <div></div>
    <p class="ring-text-last">
      {t(
        "BONANZA RANCH. DIE VISION VON EINEM LEBEN IN SÜDAFRIKA.",
        "BONANZA RANCH. A VISION FOR LIFE IN SOUTH AFRICA.",
      )}
    </p>
  </div>
</section>
