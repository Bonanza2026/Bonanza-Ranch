---
import "../styles/reserve-introduction.css";
const { lang = "de" } = Astro.props;
const en = lang === "en";
const t = (de: string, english: string) => (en ? english : de);
const e = "/bonanza/experiences/";
---

<!-- Sobha luxury-homes: staggered triptych, opening centre and editorial return. -->
<section class="reserve-introduction" id="traum" data-nav-theme="light">
  <div class="reserve-parallax-wrapper">
    <header class="reserve-opening-title">
      <p class="dream-label">
        {t("DIE VISION VON BONANZA", "THE BONANZA VISION")}
      </p>
      <h2>
        {t("Afrikas Wildnis.", "African wilderness.")}
        <br />
        {t("Ihr privater Rückzugsort.", "Your private retreat.")}
      </h2>
    </header>
    <div class="reserve-triptych-sticky">
      <div class="reserve-triptych">
        <figure class="reserve-side reserve-side-left">
          <div>
            <img
              src={`${e}leopard-portrait.webp`}
              alt={t(
                "Leopard im südafrikanischen Busch",
                "Leopard in the South African bush",
              )}
              width="1080"
              height="799"
              loading="lazy"
            />
          </div>
        </figure>
        <figure class="reserve-center">
          <img
            src={`${e}lioness-portrait.webp`}
            alt={t(
              "Löwin im Porträt",
              "Portrait of a lioness",
            )}
            width="1080"
            height="1401"
            loading="lazy"
          />
        </figure>
        <figure class="reserve-side reserve-side-right">
          <div>
            <img
              src={`${e}springbok-leap.webp`}
              alt={t(
                "Springböcke in der offenen Landschaft",
                "Springbok in the open landscape",
              )}
              width="1080"
              height="716"
              loading="lazy"
            />
          </div>
        </figure>
      </div>
    </div>
  </div>
  <div class="reserve-editorial">
    <h2>
      {t("Raum für die Natur.", "Room for nature.")}
      <br />
      <em>{t("Freiheit für Ihr Leben.", "Freedom to live.")}</em>
    </h2>
    <div class="reserve-editorial-grid">
      <div class="reserve-facts">
        <div class="reserve-areas">
          <p class="reserve-area">
            <span class="reserve-area-value">{en ? "6,300" : "6.300"} <em>ha</em></span>
            <small>BONANZA RANCH<span>{t("Natur pur", "Pure nature")}</span></small>
          </p>
          <p class="reserve-area">
            <span class="reserve-area-value">{en ? "36,000" : "36.000"} <em>ha</em></span>
            <small>{t("WILDSCHUTZGEBIET", "WILDLIFE RESERVE")}<span>{t("Rund um unsere Ranch", "Surrounding our ranch")}</span></small>
          </p>
        </div>
        <p>
          {t(
            "Der Wind rauscht durch das Gras. In der Ferne ein Vogelruf. Dazwischen: Stille. Unsere Bonanza Ranch liegt in der Klein Karoo, umgeben von einem weitläufigen Wildschutzgebiet. Landschaft bis zum Horizont. Hier planen wir einen privaten Rückzugsort für Menschen, die Afrika nicht nur bereisen, sondern künftig einen Teil ihres Lebens hier verbringen möchten.",
            "Wind rustles through the grass. A bird calls in the distance. Then, stillness. Our Bonanza Ranch lies in the Klein Karoo, surrounded by an extensive wildlife reserve. Open country stretches to the horizon. Here, we are planning a private retreat for people who want more than a visit to Africa: a place to spend part of their future.",
          )}
        </p>
      </div>
      <figure class="reserve-editorial-image">
        <img
          src={`${e}bush-trail.webp`}
          alt={t(
            "Ein Weg durch die Weite der Kapregion",
            "A trail through the open Cape landscape",
          )}
          width="1440"
          height="960"
          loading="lazy"
        />
      </figure>
    </div>
  </div>
</section>
