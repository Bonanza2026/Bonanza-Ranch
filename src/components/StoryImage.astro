---
const { src, srcset, sizes, alt, width = 1600, height = 1000, caption, concept = false, position = '50% 50%', aspect = 'landscape', class: className = '' } = Astro.props;
---
<figure class:list={['story-photo',className]} style={`--photo-ratio:${aspect === 'square' ? 1 : 16 / 9}`}>
 <img src={src} srcset={srcset} sizes={sizes} alt={alt} loading="lazy" decoding="async" style={`object-position:${position}`} width={width} height={height} />
 {(caption || concept) && <figcaption class:list={{'has-story-caption': Boolean(caption)}}>
  {caption && <span class="photo-caption">{caption}</span>}
  {concept && <span class="photo-concept">{Astro.props.lang==='en'?'CONCEPT VISUALISATION':'KONZEPTVISUALISIERUNG'}</span>}
 </figcaption>}
</figure>
