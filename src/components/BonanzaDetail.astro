---
import { bonanzaDetails, type DetailSlug } from '../content/bonanza-details';
import { bonanzaDetailsEn } from '../content/bonanza-details-en';
interface Props { slug: DetailSlug; lang?: 'de' | 'en' }
const { slug, lang = 'de' } = Astro.props;
const en = lang === 'en';
const page = en ? bonanzaDetailsEn[slug] : bonanzaDetails[slug];
const pageData = { galleryItems: page.gallery.map(({ title, body }) => ({ title, body })), activitiesScrollItems: [] };
const imageStyle = (position = '50% 50%') => `position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:${position}`;
---

<div class="bonanza-detail" data-detail={slug}>
  <div class="page-content">
    <div class="fixed-banner-loader" data-nav-theme="true">
      <div class="fixed-banner_bg" style="--dim-opacity:0.3">
        <img class="img-fill" src={page.hero.image} alt={page.hero.alt} fetchpriority="high" decoding="async" style={imageStyle(page.hero.position)} />
        <div class="dim"></div>
      </div>
      <div class="fixed-banner_fade"></div>
      <div class="fixed-banner">
        <div class="fixed-banner_content" style="--banner-height:100svh;--banner-mobile-height:100svh">
          <div class="fixed-banner_inner fixed-banner_inner--large">
            <h1 class="is-italic">{page.hero.title}</h1>
            <p>{page.hero.body}</p>
            <p class="fixed-banner_coordinates">{page.hero.concept ? (en ? 'Concept visualisation · In development' : 'Konzeptvisualisierung · In Entwicklung') : (en ? 'Bonanza Ranch · South Africa' : 'Bonanza Ranch · Südafrika')}</p>
          </div>
        </div>
      </div>
    </div>

    <section class="padding-large" aria-labelledby="detail-intro-title">
      <div class="container-small">
        <div class="v-flex_center">
          <p class="t-body is-faded">{page.label} · {en ? 'The concept' : 'Das Konzept'}</p>
          <h2 class="section-title" id="detail-intro-title">{page.title}</h2>
          <p class="t-body">{page.intro}</p>
        </div>
      </div>
    </section>

    <section class="padding-none" aria-label={page.label}>
      <div class="itinerary-scrub_component">
        <div class="itinerary-scrub_container container-large">
          <div class="itinerary-scrub_layout u-grid no-gap" style={`--item-count:${page.chapters.length}`}>
            <div class="itinerary-sticky col-4">
              <div class="itinerary-sticky_head">
                <h2 class="h3">{page.heading}</h2>
                <p class="h3 is-faded">{page.subheading}</p>
              </div>
              <div class="itinerary-sticky_bottom">
                <div class="v-flex_left-small">
                  <p class="t-title-italic">{page.noteTitle}</p>
                  <p class="t-body is-faded">{page.note}</p>
                </div>
              </div>
            </div>
            <div class="itinerary-scrub_wrap col-8">
              <div class="itinerary-scrub_inner">
                <div class="itinerary-scrub_col itinerary-scrub_left">
                  <div class="itinerary-scrub_items-wrapper">
                    {page.chapters.map((chapter, index) => (
                      <article class="itinerary-scrub_item item-expanded" id={chapter.id}>
                        <div class="itinerary-scrub_item-inner">
                          <div class="itinerary-scrub_item-num"><div class="itinerary-scrub_item-num-inner"><span class="h3 is-italic">{String(index + 1).padStart(2, '0')}</span></div></div>
                          <div class="itinerary-scrub_item-title"><h3 class="t-title-italic">{chapter.title}</h3></div>
                          <div class="itinerary-scrub_item-content">
                            <div class="itinerary-scrub_item-content-inner">
                              <div class="itinerary-scrub_item-content-wrap">
                                <p class="t-body is-faded">{chapter.body}</p>
                                <ul class="bonanza-detail_facts t-body">{chapter.facts.map(fact => <li>{fact}</li>)}</ul>
                                {chapter.concept && <p class="bonanza-detail_caption">{en ? 'Illustrative concept visualisation.' : 'Abbildung: unverbindliche Konzeptvisualisierung.'}</p>}
                              </div>
                            </div>
                          </div>
                        </div>
                        <figure class="bonanza-detail_mobile-media">
                          <img src={chapter.image} alt={chapter.alt} loading="lazy" decoding="async" style={`object-position:${chapter.position || '50% 50%'}`} />
                        </figure>
                      </article>
                    ))}
                  </div>
                </div>
                <div class="itinerary-scrub_col itinerary-scrub_right" aria-hidden="true">
                  {page.chapters.map((chapter, index) => (
                    <div class="itinerary-scrub_media-wrap" data-media-index={index} style={`z-index:${page.chapters.length - index}`}>
                      <div class="image-with-overlay image-with-overlay--fill itinerary-scrub_media" style="--overlay-opacity:0">
                        <img class="image-with-overlay_img" src={chapter.image} alt="" loading="lazy" decoding="async" style={imageStyle(chapter.position)} />
                        <div class="image-overlay"></div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="padding-none" aria-label="Einblicke in die Landschaft">
      <div class="gallery-slider" role="region" aria-label="Bonanza Bildergalerie" aria-roledescription="Karussell" tabindex="0">
        <div class="gallery-slider_wrap">
          <button class="gallery-slider_zone gallery-slider_zone--left" type="button" data-cursor-text={en ? "Previous" : "Zurück"} data-cursor-glass="true" aria-label={en ? "Previous image" : "Vorheriges Bild"}></button>
          <button class="gallery-slider_zone gallery-slider_zone--right" type="button" data-cursor-text={en ? "Next" : "Weiter"} data-cursor-glass="true" aria-label={en ? "Next image" : "Nächstes Bild"}></button>
          {page.gallery.map((item, index) => (
            <div class="gallery-slider_item" style={`clip-path:${index === 0 ? 'polygon(0 0,100% 0,100% 100%,0 100%)' : 'polygon(0 0,0 0,0 100%,0 100%)'}`}>
              <img class="gallery-slider_image" src={item.image} alt={item.alt} loading="lazy" decoding="async" style={imageStyle(item.position)} />
            </div>
          ))}
          <div class="gallery-slider_ui">
            <div class="gallery-slider_contain container">
              <div class="gallery-slider_ui-layout">
                <div class="gallery-slider_ui-left">
                  <div class="gallery-slider_info">
                    <div class="gallery-slider_info-wrap">
                      <div class="gallery-slider_info-title"><p class="gallery-slider_info-title-text t-title-italic">{page.gallery[0].title}</p></div>
                      <div class="gallery-slider_info-dropdown"><div class="gallery-slider_info-dropdown-inner"><div class="gallery-slider_info-dropdown-content"><p class="t-body">{page.gallery[0].body}</p></div></div></div>
                    </div>
                  </div>
                </div>
                <div class="gallery-slider_ui-right">
                  <div class="gallery-slider_thumbs-wrap" role="tablist" aria-label={en ? "Choose image" : "Bildauswahl"}>
                    {page.gallery.map((item, index) => <div class:list={['gallery-slider_thumb', { 'is-active': index === 0 }]} role="tab" tabindex="0" aria-selected={index === 0} aria-label={`${en ? "Image" : "Bild"} ${index + 1}: ${item.title}`}><img class="gallery-slider_thumb-image" src={item.image} alt="" loading="lazy" decoding="async" style={imageStyle(item.position)} /></div>)}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="padding-large" aria-label="Leben auf Bonanza">
      <div class="container-small"><div class="v-flex_center"><h2 class="section-title">{page.closing}</h2><p class="t-body">{page.closingBody}</p></div></div>
    </section>
    <div class="entertainment-intro">
      <div class="entertainment-imgs_outer"><div class="entertainment-imgs_inner">
        <div class="entertainment-img is-left"><div class="entertainment-img_wrap"><img src={page.closingImages[0].image} alt={page.closingImages[0].alt} loading="lazy" decoding="async" style={imageStyle()} /></div></div>
        <div class="entertainment-img entertain-sticky"><img src={page.closingImages[1].image} alt={page.closingImages[1].alt} loading="lazy" decoding="async" style={imageStyle()} /></div>
        <div class="entertainment-img is-right"><div class="entertainment-img_wrap"><img src={page.closingImages[2].image} alt={page.closingImages[2].alt} loading="lazy" decoding="async" style={imageStyle()} /></div></div>
      </div></div>
      <section class="padding-none bg-transparent" data-nav-theme="true"><div class="container-small u-white"><div class="v-flex_center"><h2 class="section-title">Bonanza Ranch</h2></div></div></section>
      <div class="mist-divider_wrap">
        <div class="mist-transition"><div class="mist-transition_image-container"><img class="mist-transition_image" src="/images/cloud-gradient.webp" alt="" width="1920" height="1080" loading="lazy" /></div></div>
        <div class="clouds-divider" data-scroll-speed="-10%"><img src="/images/mist-gradient.webp" alt="" width="1920" height="1080" loading="lazy" /></div>
      </div>
    </div>
  </div>
</div>
<script id="bonanza-page-data" type="application/json" set:html={JSON.stringify(pageData).replace(/</g, '\\u003c')} />

<style>
  .gallery-slider_zone { z-index:3; }
  .gallery-slider_ui { z-index:4; }
  .fixed-banner_content { opacity:1; }
  .itinerary-scrub_inner,
  .itinerary-scrub_item { background-color:#283128; color:#f4f1e9; }
  .itinerary-scrub_item { border-bottom-color:rgba(222,211,179,.22); }
  .itinerary-scrub_item .h3,
  .itinerary-scrub_item .t-title-italic { color:#f4f1e9; }
  .itinerary-scrub_item .t-body { color:#dedfcf; }
  .itinerary-scrub_item .is-faded { color:#c9cebd; opacity:1; }
  .bonanza-detail_facts { margin:1.5em 0 0; padding:0; list-style:none; }
  .bonanza-detail_facts li { padding:.6em 0; border-top:1px solid rgba(222,211,179,.22); }
  .bonanza-detail_caption { margin-top:1.5em; font-size:.75rem; line-height:1.4; color:#bec5b2; opacity:1; }
  .bonanza-detail_mobile-media { display:none; }
  @media(max-width:768px) {
    .bonanza-detail_mobile-media { display:block; margin:1.75rem 0 0; width:100%; aspect-ratio:4/3; overflow:hidden; border-radius:.25rem; }
    .bonanza-detail_mobile-media img { width:100%; height:100%; object-fit:cover; }
    .itinerary-scrub_right { display:none; }
  }
  @media(prefers-reduced-motion:reduce) {
    .itinerary-scrub_layout { height:auto!important; }
    .itinerary-scrub_inner,.itinerary-scrub_wrap,.itinerary-scrub_left { height:auto!important; position:relative!important; overflow:visible!important; }
    .itinerary-scrub_right { display:none; }
    .itinerary-scrub_left { width:100%; }
    .bonanza-detail_mobile-media { display:block; margin:1.75rem 0 0; aspect-ratio:4/3; overflow:hidden; }
    .bonanza-detail_mobile-media img { width:100%; height:100%; object-fit:cover; }
  }
</style>
