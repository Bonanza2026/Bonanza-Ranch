---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import CookieNotice from "../components/CookieNotice.astro";
import ContactOptions from "../components/ContactOptions.astro";
import { languagePages, siteUrl } from '../../site.config.mjs';
import { markdownPath } from '../../agent-content.mjs';
import { webMcpOriginTrialToken } from '../../webmcp-trial.mjs';
import { homeMetadata } from '../content/site-metadata.mjs';
import { createStructuredData, serializeStructuredData } from '../content/structured-data.mjs';
import "../styles/site-base.css";
import "../styles/bonanza.css";
import "../styles/dream.css";
import "../styles/bonanza-type.css";
import "../styles/legal.css";
import "../styles/mobile-polish.css";
import "../styles/story-editorial.css";
import "../styles/mobile-journey.css";
import "../styles/color-theme.css";
import "../styles/wildlife-flow.css";
const { lang = 'de' } = Astro.props;
const locale = lang === 'en' ? 'en' : 'de';
const { title = homeMetadata[locale].title, description = homeMetadata[locale].description } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const pages = languagePages.find((pair) => Object.values(pair).includes(pathname)) || languagePages[0];
const canonical = siteUrl + pages[lang === 'en' ? 'en' : 'de'];
const isHome = ['/', '/de', '/en'].includes(pathname);
const structuredData = createStructuredData({ path: pages[locale], lang: locale, title, description });
const webMcpTrialToken = import.meta.env.PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN?.trim() || webMcpOriginTrialToken;
---

<!doctype html>
<html lang={lang} translate="no" data-color-theme={isHome ? 'cream' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#fafaf8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google" content="notranslate" />
    {webMcpTrialToken && <meta http-equiv="origin-trial" content={webMcpTrialToken} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/markdown" href={siteUrl + markdownPath(pages[lang === 'en' ? 'en' : 'de'])} />
    <link rel="describedby" type="text/plain" href={siteUrl + '/llms.txt'} />
    <link rel="describedby" type="text/plain" href={siteUrl + '/llms-full.txt'} />
    <link rel="api-catalog" type="application/linkset+json" href={siteUrl + '/.well-known/api-catalog'} />
    <link rel="alternate" hreflang="de" href={siteUrl + pages.de} />
    <link rel="alternate" hreflang="en" href={siteUrl + pages.en} />
    <link rel="alternate" hreflang="x-default" href={siteUrl + pages.en} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bonanza Ranch" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'de_DE'} />
    <meta property="og:image" content={siteUrl + '/media/hero-poster-v3.webp'} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="900" />
    <meta property="og:image:alt" content={lang === 'en' ? 'Two giraffes in a South African mountain landscape' : 'Zwei Giraffen in einer südafrikanischen Berglandschaft'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={serializeStructuredData(structuredData)} />
    <link rel="icon" type="image/webp" href="/bonanza/favicon.webp" />
    <link rel="preload" href="/fonts/Inter-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/PPFragment-GlareVariable.woff" as="font" type="font/woff" crossorigin />
    {isHome && <>
      <link rel="preload" href="/media/hero-poster-mobile-v3.webp" as="image" media="(max-width: 767px)" fetchpriority="high" />
      <link rel="preload" href="/media/hero-poster-v3.webp" as="image" media="(min-width: 768px)" fetchpriority="high" />
    </>}
  </head>
  <body>
    <a href="#inhalt" class="skip-link">
      {lang === 'en' ? 'Skip to content' : 'Zum Inhalt'}
    </a>
    <SiteHeader lang={lang} />
    <main id="inhalt" class="page-main">
      <div class="page-content">
        <slot />
      </div>
    </main>
    <SiteFooter lang={lang} />
    <CookieNotice lang={lang} />
    <ContactOptions lang={lang} />
    <div class="custom-cursor" aria-hidden="true">
      <div class="custom-cursor_line-vertical"></div>
      <div class="custom-cursor_line-horizontal"></div>
      <div class="custom-cursor_dot"></div>
      <div class="custom-cursor_label">
        <span class="custom-cursor_label-text"></span>
      </div>
    </div>
    <dialog class="ranch-film">
      <button data-film-close aria-label={lang === 'en' ? 'Close film' : 'Film schließen'}>
        {lang === 'en' ? 'Close ×' : 'Schließen ×'}
      </button>
      <video
        controls
        playsinline
        preload="none"
      >
        <source data-src="/media/hero_film.webm" type='video/webm; codecs="vp9"' />
        <source data-src="/media/film-v2.mp4" type='video/mp4; codecs="avc1.640028, mp4a.40.2"' />
      </video>
    </dialog>
    <script>
      import '../scripts/webmcp.mjs';
    </script>
    <script>
      // Local palette comparison; no persistence or tracking.
      if (document.documentElement.hasAttribute('data-color-theme')) {
        document.documentElement.dataset.colorTheme =
          new URLSearchParams(location.search).get('theme') === 'dark' ? 'dark' : 'cream';
      }
      // Let the server-rendered hero paint before initializing scroll scenes.
      const start = () => import("../scripts/runtime");
      if (typeof PerformanceObserver !== 'undefined' && PerformanceObserver.supportedEntryTypes.includes('paint')) {
        const observer = new PerformanceObserver((list) => {
          if (!list.getEntries().some(entry => entry.name === 'first-contentful-paint')) return;
          observer.disconnect();
          start();
        });
        observer.observe({type: 'paint', buffered: true});
      } else {
        requestAnimationFrame(() => requestAnimationFrame(start));
      }
    </script>
  </body>
</html>
