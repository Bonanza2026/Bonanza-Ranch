{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; worker-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), tools=(self)"
        }
      ]
    },
    {
      "source": "/(robots.txt|llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </llms-full.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\", </.well-known/ard.json>; rel=\"ard\"; type=\"application/json\", </.well-known/ai-catalog.json>; rel=\"ai-catalog\"; type=\"application/json\""
        }
      ]
    },
    {
      "source": "/(de|en|impressum|datenschutz|en/legal|en/privacy)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/_agent-markdown/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/(.well-known/api-catalog|api-catalog.json)",
      "headers": [
        { "key": "Content-Type", "value": "application/linkset+json; profile=\"https://www.rfc-editor.org/info/rfc9727\"" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/.well-known/(ard|ai-catalog).json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.oai.openapi+json" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/api/content/(.*).json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/api/docs.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }]
    },
    {
      "source": "/media/hero-mobile-v4.webm",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media/hero-mobile-v4.mp4",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media/hero-mobile-v5.webm",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media/hero-mobile-v5.mp4",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media/hero-mobile-v6.webm",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media/hero-mobile-v6.mp4",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media/hero-mobile-v7.webm",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/media/hero-mobile-v7.mp4",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [{ "source": "/.well-known/api-catalog", "destination": "/api-catalog.json" }],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bonanza-ranch.com"
        }
      ],
      "destination": "https://www.bonanza-ranch.com/:path*",
      "permanent": true
    },
    {
      "source": "/de/",
      "destination": "/de",
      "permanent": true
    },
    {
      "source": "/en/",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/impressum/",
      "destination": "/impressum",
      "permanent": true
    },
    {
      "source": "/en/legal/",
      "destination": "/en/legal",
      "permanent": true
    },
    {
      "source": "/datenschutz/",
      "destination": "/datenschutz",
      "permanent": true
    },
    {
      "source": "/en/privacy/",
      "destination": "/en/privacy",
      "permanent": true
    },
    {
      "source": "/freizeit",
      "destination": "/de#freizeit",
      "permanent": true
    },
    {
      "source": "/freizeit/",
      "destination": "/de#freizeit",
      "permanent": true
    },
    {
      "source": "/sicherheit",
      "destination": "/de#sicherheit",
      "permanent": true
    },
    {
      "source": "/sicherheit/",
      "destination": "/de#sicherheit",
      "permanent": true
    },
    {
      "source": "/en/leisure",
      "destination": "/en#freizeit",
      "permanent": true
    },
    {
      "source": "/en/leisure/",
      "destination": "/en#freizeit",
      "permanent": true
    },
    {
      "source": "/en/security",
      "destination": "/en#sicherheit",
      "permanent": true
    },
    {
      "source": "/en/security/",
      "destination": "/en#sicherheit",
      "permanent": true
    }
  ]
}
